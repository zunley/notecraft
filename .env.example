# 登录账号（必填，单用户；多用户演进见 docs/DESIGN-V2.md §6）
NOTE_MD_USERNAME=admin
NOTE_MD_PASSWORD=change-me

# token 有效期（可选，默认 72h；支持 s/m/h/d）
NOTE_MD_TOKEN_TTL=72h

# 对外映射端口（可选，默认 8080）
NOTE_MD_PORT=8080

# 应用数据目录（容器内，默认 /data；会话归档写入其 sessions/）
NOTE_MD_DATA_DIR=/data

# LLM 网关（OpenAI 兼容；仅服务端中继使用，不下发客户端）
OPENAI_BASE_URL=https://your-llm-gateway/v1
OPENAI_API_KEY=sk-...
OPENAI_MODEL=qwen-plus
