# 注册策略（可选，默认 open）：open=任何人可注册 / invite=需邀请码 / closed=仅已有账号可登录
NOTE_MD_REGISTRATION=open
# 邀请码（invite 模式下使用，可选）
# NOTE_MD_INVITE_CODE=change-me

# token 有效期（可选，默认 72h；支持 s/m/h/d）
NOTE_MD_TOKEN_TTL=72h

# 对外映射端口（可选，默认 8080）
NOTE_MD_PORT=8080

# 应用数据目录（容器内，默认 /data）
# 存用户表（每用户登录凭证哈希 + protected_key 信封）——必须备份，丢失即无法登录/解锁
NOTE_MD_DATA_DIR=/data

# 限速与配额（可选，全部有代码默认值，见 docs/API.md §7）
# NOTE_MD_AUTH_RATE=10          # 注册/登录 次/分/IP
# NOTE_MD_FILE_MAX=1048576      # 单文件密文上限（字节）
# NOTE_MD_STORAGE_QUOTA=1073741824   # 每用户存储配额（字节）
# NOTE_MD_RELAY_DAILY_QUOTA=200 # 中继日配额（次/天/用户）

# LLM 网关（OpenAI 兼容；仅服务端中继使用，不下发客户端）
OPENAI_BASE_URL=https://your-llm-gateway/v1
OPENAI_API_KEY=sk-...
OPENAI_MODEL=qwen-plus
